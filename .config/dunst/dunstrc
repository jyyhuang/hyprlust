[global]
    monitor = 0
    follow = keyboard
    width = (250, 500)
    height = (0, 750)
    origin = top-right
    offset = (20, 20)
    scale = 0
    notification_limit = 20
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 5
    progress_bar_corners = all
    icon_corner_radius = 0
    icon_corners = all
    indicate_hidden = yes
    transparency = 35
    padding = 8
    horizontal_padding = 8
    text_icon_padding = 0
    frame_width = 1
    frame_color = "#509FA5"
    gap_size = 3
    separator_color = frame
    sort = yes
    font = Monocraft Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 64
    max_icon_size = 64
    corner_radius = 5
    corners = all
    layer = top

[urgency_low]
    background = "#3D3E4355"
    foreground = "#ADE1E555"
    timeout = 3

[urgency_normal]
    background = "#3D3E4355"
    foreground = "#ADE1E5"
    timeout = 5

[urgency_critical]
    background = "#3D3E4355"
    foreground = "#ADE1E5"
    frame_color = "#ff0000"
    timeout = 15
